{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onme.local/schema/pack/v1",
  "title": "Paczka zadań OnMe (PlayOnMe + StudyOnMe)",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "subject", "cards"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "examples": ["csharp", "tsql", "networking", "ladder"] },
    "locale": { "type": "string", "default": "pl" },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "description": { "type": "string" },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "title"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" }
        }
      }
    },
    "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/card" } }
  },
  "$defs": {
    "card": {
      "type": "object",
      "required": ["id", "type", "prompt", "answer", "explanation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "type": { "enum": ["predict_output", "find_bug", "quiz", "flashcard"] },
        "level": { "type": "integer", "minimum": 1, "default": 1 },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5, "default": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "prompt": { "type": "string", "minLength": 1 },
        "code": { "type": "string" },
        "codeLanguage": { "type": "string" },
        "answer": { "$ref": "#/$defs/answer" },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "options", "correct"],
          "properties": {
            "kind": { "const": "choice" },
            "options": { "type": "array", "minItems": 2, "items": { "type": "string" } },
            "correct": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "accepted"],
          "properties": {
            "kind": { "const": "text" },
            "accepted": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "line"],
          "properties": {
            "kind": { "const": "line" },
            "line": { "type": "integer", "minimum": 1 },
            "fix": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
